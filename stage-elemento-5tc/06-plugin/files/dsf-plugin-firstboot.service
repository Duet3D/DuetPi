[Unit]
Description=DSF Plugin First-Boot Installer
# Aspetta che DCS e ENTRAMBI i plugin service siano completamente avviati
After=network-online.target duetcontrolserver.service duetpluginservice.service duetpluginservice-root.service
Wants=network-online.target
Requires=duetcontrolserver.service duetpluginservice.service duetpluginservice-root.service
# Solo se il flag file esiste (rimosso dallo script dopo il successo)
ConditionPathExists=/opt/dsf-plugins-pending/.pending

[Service]
Type=oneshot
ExecStart=/usr/local/bin/install-dsf-plugin.sh
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
